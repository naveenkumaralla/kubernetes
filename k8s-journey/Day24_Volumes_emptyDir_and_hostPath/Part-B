----------------------------------------
NODE=$(k get pod ed -o jsonpath='{.spec.nodeName}')
PUID=$(k get pod ed -o jsonpath='{.metadata.uid}')
docker exec $NODE ls /var/lib/kubelet/pods/$PUID/volumes/kubernetes.io~empty-dir/work


