STEP 2: A cluster-wide default deny that skips system namespaces
----------------------------------------------------------------
mkdir -p ~/k8s-journey/week9/cni && cd $_
vi calico-global.yaml

apiVersion: projectcalico.org/v3
kind: GlobalNetworkPolicy
metadata:
  name: default-deny-apps
spec:
  namespaceSelector: has(projectcalico.org/name) && projectcalico.org/name not in {"kube-system", "calico-system", "calico-apiserver", "tigera-operator"}
  types:
  - Ingress
  - Egress
  egress:
  - action: Allow
    protocol: UDP
    destination:
      selector: k8s-app == "kube-dns"
      ports: [53]
  - action: Allow
    protocol: TCP
    destination:
      selector: k8s-app == "kube-dns"
      ports: [53]

k apply -f calico-global.yaml
k create ns t1
k run a -n t1 --image=nginx:1.27 --labels=app=a --expose --port=80
k run b -n t1 --image=busybox:1.36 --labels=app=b -- sleep 3600
k exec -n t1 b -- wget -qO- -T 2 a     # blocked (by the GLOBAL policy)
k exec -n t1 b -- nslookup a           # DNS allowed

Then allow b -> a with a normal Kubernetes NetworkPolicy (ingress on
a from app=b) PLUS an egress rule for b, and test again.
Note: Calico policies have an "order" field; lower order is evaluated
first, and "action: Deny" exists, unlike Kubernetes NetworkPolicy.

k delete ns t1 ; k delete -f calico-global.yaml


