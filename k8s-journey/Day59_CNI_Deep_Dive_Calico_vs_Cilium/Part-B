STEP 7: DNS-aware egress (FQDN)
-------------------------------
vi cilium-fqdn.yaml

apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: client-egress
  namespace: l7
spec:
  endpointSelector:
    matchLabels:
      app: client
  egress:
  - toEndpoints:
    - matchLabels:
        k8s:io.kubernetes.pod.namespace: kube-system
        k8s-app: kube-dns
    toPorts:
    - ports:
      - port: "53"
        protocol: ANY
      rules:
        dns:
        - matchPattern: "*"
  - toFQDNs:
    - matchName: "example.com"
  - toEndpoints:
    - matchLabels:
        app: httpbin

k apply -f cilium-fqdn.yaml
k exec -n l7 client -- curl -s -m 5 -o /dev/null -w "%{http_code}\n" https://example.com     # allowed
k exec -n l7 client -- curl -s -m 5 -o /dev/null -w "%{http_code}\n" https://kubernetes.io   # blocked
hubble observe -n l7 --type drop --last 10


