STEP 5: App + L7 policy
-----------------------
cd ~/k8s-journey/week9/cni
k create ns l7
k create deploy httpbin -n l7 --image=mccutchen/go-httpbin --port=8080
k expose deploy httpbin -n l7 --port=8080
k run client -n l7 --image=nicolaka/netshoot --labels=app=client -- sleep infinity
k run other  -n l7 --image=nicolaka/netshoot --labels=app=other  -- sleep infinity
k wait -n l7 --for=condition=ready pod --all --timeout=120s

k exec -n l7 client -- curl -s -o /dev/null -w "%{http_code}\n" httpbin:8080/get
k exec -n l7 client -- curl -s -o /dev/null -w "%{http_code}\n" -X POST httpbin:8080/post

vi cilium-l7.yaml

apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: httpbin-l7
  namespace: l7
spec:
  endpointSelector:
    matchLabels:
      app: httpbin
  ingress:
  - fromEndpoints:
    - matchLabels:
        app: client
    toPorts:
    - ports:
      - port: "8080"
        protocol: TCP
      rules:
        http:
        - method: GET
          path: "/get"
        - method: GET
          path: "/headers"

k apply -f cilium-l7.yaml
k exec -n l7 client -- curl -s -o /dev/null -w "%{http_code}\n" httpbin:8080/get            # 200
k exec -n l7 client -- curl -s -o /dev/null -w "%{http_code}\n" -X POST httpbin:8080/post   # 403 (L7 denied)
k exec -n l7 client -- curl -s -o /dev/null -w "%{http_code}\n" httpbin:8080/status/200     # 403
k exec -n l7 other  -- curl -s -m 3 -o /dev/null -w "%{http_code}\n" httpbin:8080/get       # 000 (L3 dropped)

Note the difference: L7 denials return HTTP 403 from the Envoy proxy;
L3/L4 denials are silent drops (timeout).


