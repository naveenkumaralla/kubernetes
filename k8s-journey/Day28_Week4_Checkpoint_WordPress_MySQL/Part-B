STEP 3: MySQL StatefulSet + headless Service
--------------------------------------------
vi mysql.yaml

apiVersion: v1
kind: Service
metadata:
  name: mysql
spec:
  clusterIP: None
  selector: {app: mysql}
  ports:
  - port: 3306
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mysql
spec:
  serviceName: mysql
  replicas: 1
  selector:
    matchLabels: {app: mysql}
  template:
    metadata:
      labels: {app: mysql}
    spec:
      containers:
      - name: mysql
        image: mysql:8.4
        envFrom:
        - configMapRef:
            name: wp-config
        env:
        - name: MYSQL_ROOT_PASSWORD
          valueFrom:
            secretKeyRef: {name: mysql-pass, key: MYSQL_ROOT_PASSWORD}
        - name: MYSQL_PASSWORD
          valueFrom:
            secretKeyRef: {name: mysql-pass, key: MYSQL_PASSWORD}
        ports:
        - containerPort: 3306
        volumeMounts:
        - name: data
          mountPath: /var/lib/mysql
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: ["ReadWriteOnce"]
      resources:
        requests:
          storage: 2Gi

(The WORDPRESS_* keys in the ConfigMap also become env vars in MySQL;
harmless. Optional improvement: split into two ConfigMaps.)


STEP 4: WordPress Deployment + PVC + Service
--------------------------------------------
vi wordpress.yaml

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: wp-content
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wordpress
spec:
  replicas: 1
  strategy:
    type: Recreate          # RWO volume can't be shared by old+new pod
  selector:
    matchLabels: {app: wordpress}
  template:
    metadata:
      labels: {app: wordpress}
    spec:
      containers:
      - name: wordpress
        image: wordpress:6-apache
        envFrom:
        - configMapRef:
            name: wp-config
        env:
        - name: WORDPRESS_DB_PASSWORD
          valueFrom:
            secretKeyRef: {name: mysql-pass, key: MYSQL_PASSWORD}
        ports:
        - containerPort: 80
        volumeMounts:
        - name: content
          mountPath: /var/www/html
      volumes:
      - name: content
        persistentVolumeClaim:
          claimName: wp-content
---
apiVersion: v1
kind: Service
metadata:
  name: wordpress
spec:
  selector: {app: wordpress}
  ports:
  - port: 80

Why Recreate? With RollingUpdate the new pod would wait for the RWO
volume still attached to the old pod (and on another node it would
never attach).


