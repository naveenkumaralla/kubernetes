STEP 4: Redis work queue
------------------------
k create deploy redis --image=redis:7-alpine --port=6379
k expose deploy redis --port=6379
k rollout status deploy/redis

Producer: push 20 tasks
  k run producer --rm -it --image=redis:7-alpine --restart=Never -- \
    sh -c 'for i in $(seq 1 20); do redis-cli -h redis RPUSH jobs "task-$i"; done; redis-cli -h redis LLEN jobs'

Worker Job: pops until the queue is empty
vi queue-job.yaml

apiVersion: batch/v1
kind: Job
metadata:
  name: queue-workers
spec:
  parallelism: 4
  ttlSecondsAfterFinished: 600
  template:
    spec:
      restartPolicy: OnFailure
      containers:
      - name: worker
        image: redis:7-alpine
        command:
        - sh
        - -c
        - |
          while true; do
            T=$(redis-cli -h redis LPOP jobs)
            [ -z "$T" ] && echo "queue empty, exiting" && exit 0
            echo "$(hostname) processing $T"; sleep 1
          done

k apply -f queue-job.yaml
k get pods -l job-name=queue-workers -w
for p in $(k get pods -l job-name=queue-workers -o name); do k logs $p | tail -3; done

No completions set: the Job is done when all workers exit 0. Each task
was processed exactly once (LPOP is atomic). For real "at-least-once"
safety use BRPOPLPUSH/LMOVE into a processing list, or a real queue.


