STEP 3: A tiny controller (bash, for learning)
----------------------------------------------
vi controller.sh

#!/bin/bash
# Reconcile every Website into a ConfigMap + Deployment + Service.
NS=${NS:-default}
reconcile() {
  name=$1
  msg=$(kubectl get website $name -n $NS -o jsonpath='{.spec.message}' 2>/dev/null) || return
  if [ -z "$msg" ]; then
    echo "website $name gone; children are removed by owner references"; return
  fi
  replicas=$(kubectl get website $name -n $NS -o jsonpath='{.spec.replicas}')
  color=$(kubectl get website $name -n $NS -o jsonpath='{.spec.color}')
  uid=$(kubectl get website $name -n $NS -o jsonpath='{.metadata.uid}')
  echo "reconciling $name: replicas=$replicas color=$color"
  cat <<EOF | kubectl apply -n $NS -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: ws-$name
  ownerReferences:
  - {apiVersion: lab.example.com/v1, kind: Website, name: $name, uid: $uid, controller: true}
data:
  index.html: "<h1 style='color:$color'>$msg</h1>"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ws-$name
  ownerReferences:
  - {apiVersion: lab.example.com/v1, kind: Website, name: $name, uid: $uid, controller: true}
spec:
  replicas: $replicas
  selector: {matchLabels: {website: $name}}
  template:
    metadata:
      labels: {website: $name}
      annotations: {msg-hash: "$(echo "$msg$color" | md5sum | cut -c1-8)"}
    spec:
      containers:
      - name: web
        image: nginx:1.27
        volumeMounts: [{name: html, mountPath: /usr/share/nginx/html}]
      volumes: [{name: html, configMap: {name: ws-$name}}]
---
apiVersion: v1
kind: Service
metadata:
  name: ws-$name
  ownerReferences:
  - {apiVersion: lab.example.com/v1, kind: Website, name: $name, uid: $uid, controller: true}
spec:
  selector: {website: $name}
  ports: [{port: 80}]
EOF
  kubectl patch website $name -n $NS --subresource=status --type=merge \
    -p "{\"status\":{\"phase\":\"Ready\"}}" >/dev/null
}
echo "controller started, watching websites in $NS"
kubectl get websites -n $NS --watch --output-watch-events -o jsonpath='{.type} {.object.metadata.name}{"\n"}' |
while read event name; do
  echo "event: $event $name"
  [ "$event" != "DELETED" ] && reconcile $name
done

