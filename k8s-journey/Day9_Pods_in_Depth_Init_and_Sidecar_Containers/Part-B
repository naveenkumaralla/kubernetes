apiVersion: v1
kind: Pod
metadata:
  name: native-sidecar
spec:
  initContainers:
  - name: helper
    image: busybox:1.36
    restartPolicy: Always
    command: ["sh", "-c", "while true; do echo helper alive; sleep 5; done"]
  containers:
  - name: app
    image: nginx:1.27

k apply -f pod-native-sidecar.yaml
k get pod native-sidecar          # READY 2/2
k logs native-sidecar -c helper


STEP 5: restartPolicy in action
-------------------------------
k run exit-always    --image=busybox:1.36 --restart=Always    -- sh -c "sleep 5; exit 1"
k run exit-onfailure --image=busybox:1.36 --restart=OnFailure -- sh -c "sleep 5; exit 0"
k run exit-never     --image=busybox:1.36 --restart=Never     -- sh -c "sleep 5; exit 1"

k get pods -w      (watch for about 2 minutes)

Record:
  exit-always:    restarts forever -> CrashLoopBackOff, RESTARTS grows
  exit-onfailure: exit 0 -> Completed, not restarted
  exit-never:     exit 1 -> Error, not restarted


STEP 6: Graceful shutdown and preStop
-------------------------------------
vi pod-prestop.yaml

apiVersion: v1
kind: Pod
metadata:
  name: prestop-demo
spec:
  terminationGracePeriodSeconds: 20
  containers:
  - name: web
    image: nginx:1.27
    lifecycle:
      preStop:
        exec:
          command: ["sh", "-c", "echo preStop running; sleep 10"]

k apply -f pod-prestop.yaml
time k delete pod prestop-demo

It takes about 10 seconds: the preStop hook ran before SIGTERM.
Compare:
  k run fast --image=nginx:1.27
  time k delete pod fast
  k run fast2 --image=nginx:1.27 && sleep 5
  time k delete pod fast2 --grace-period=0 --force


