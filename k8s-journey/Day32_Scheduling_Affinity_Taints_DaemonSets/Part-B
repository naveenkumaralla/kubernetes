----------------------------
k delete deploy ssd-app aff ha-web normal gpu-app
k delete ds node-agent ; k delete pdb normal-pdb
k label node lab-worker disktype- zone- ; k label node lab-worker2 disktype- zone-
cd ~/k8s-journey && git add . && git commit -m "day32: scheduling"
